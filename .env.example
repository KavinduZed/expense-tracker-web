# Base URL of the backend API. Leave blank in demo mode (requests stay same-origin).
VITE_API_BASE_URL=

# Demo mode: set to "true" to run the whole app against an in-browser mock backend
# (seeded data, stateful for the session) with NO real backend required. Leave blank
# or "false" to talk to the real API at VITE_API_BASE_URL.
# Demo login:  demo@example.com  /  Password123!
VITE_ENABLE_MOCKS=
